# Projeto Supabase hospedado na UE (Frankfurt ou Paris).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...). Pode ir para o navegador; o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chave secreta (sb_secret_...). SOMENTE no servidor: nunca com prefixo NEXT_PUBLIC_.
# Usada para criar e apagar contas de login das colaboradoras.
SUPABASE_SECRET_KEY=
